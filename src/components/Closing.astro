---
import { content, site, WHATSAPP_NUMBER, whatsappConfigured } from "~/data";
import type { Locale } from "~/i18n/config";
import SectionLabel from "./SectionLabel.astro";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].closing;

/*
 * Only the strings the browser script needs. Passing the whole content object
 * through `define:vars` would serialise every word of the page into the HTML a
 * second time.
 */
const strings = {
  errorRequired: t.form.errorRequired,
  errorUnconfigured: t.form.errorUnconfigured,
  messageIntro: t.form.messageIntro,
  messageBusiness: t.form.messageBusiness,
  messageNeed: t.form.messageNeed,
  messageAsk: t.form.messageAsk,
};
---

<section id="contact" class="scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.85fr] lg:gap-16">
      <div data-reveal>
        <SectionLabel number="05" label={t.label} heading={t.heading} />

        <p class="text-muted mt-6 max-w-lg text-lg leading-relaxed">{t.body}</p>

        <div class="mt-9">
          <WhatsAppButton locale={locale} label={t.cta} />
        </div>

        {
          site.email && (
            <p class="text-subtle border-line mt-10 border-t pt-6 text-sm">
              {t.emailPrefix}{" "}
              <a
                href={`mailto:${site.email}`}
                class="text-fg hover:text-accent font-medium underline underline-offset-4"
              >
                {site.email}
              </a>
            </p>
          )
        }
      </div>

      <!--
        A backup for people who freeze at an empty chat box: fill three fields
        and the button writes the WhatsApp message for them. No server, no form
        service, nothing to break — it just builds a wa.me link.
      -->
      <div class="card h-fit p-7" data-reveal>
        <h3 class="display-sm text-xl">{t.form.heading}</h3>
        <p class="text-muted mt-2 text-sm leading-relaxed">{t.form.intro}</p>

        <form id="message-builder" class="mt-6 space-y-4" novalidate>
          <div>
            <label for="mb-name" class="block text-sm font-medium"
              >{t.form.name}</label
            >
            <input
              id="mb-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class="border-line bg-canvas focus:border-accent mt-1.5 w-full rounded-lg border px-3.5 py-2.5 transition-colors"
              placeholder={t.form.namePlaceholder}
            />
          </div>

          <div>
            <label for="mb-business" class="block text-sm font-medium"
              >{t.form.business}</label
            >
            <input
              id="mb-business"
              name="business"
              type="text"
              required
              class="border-line bg-canvas focus:border-accent mt-1.5 w-full rounded-lg border px-3.5 py-2.5 transition-colors"
              placeholder={t.form.businessPlaceholder}
            />
          </div>

          <div>
            <label for="mb-need" class="block text-sm font-medium">
              {t.form.need}{" "}
              <span class="text-subtle font-normal">{t.form.needOptional}</span>
            </label>
            <textarea
              id="mb-need"
              name="need"
              rows="3"
              class="border-line bg-canvas focus:border-accent mt-1.5 w-full resize-y rounded-lg border px-3.5 py-2.5 transition-colors"
              placeholder={t.form.needPlaceholder}></textarea>
          </div>

          <p
            id="mb-error"
            role="alert"
            hidden
            class="text-accent text-sm font-medium"
          >
          </p>

          <button
            type="submit"
            class="bg-fg text-canvas hover:bg-accent hover:text-accent-fg min-h-11 w-full rounded-full px-6 py-3 font-medium transition-colors"
          >
            {t.form.submit}
          </button>

          <p class="text-subtle text-xs leading-relaxed">
            {t.form.reassurance}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ WHATSAPP_NUMBER, whatsappConfigured, strings }}
>
  const form = document.getElementById("message-builder");
  const error = document.getElementById("mb-error");

  const fail = (message) => {
    error.textContent = message;
    error.hidden = false;
  };

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    error.hidden = true;

    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const business = String(data.get("business") || "").trim();
    const need = String(data.get("need") || "").trim();

    if (!name || !business) {
      fail(strings.errorRequired);
      (name ? form.elements.business : form.elements.name).focus();
      return;
    }

    if (!whatsappConfigured) {
      fail(strings.errorUnconfigured);
      return;
    }

    const lines = [
      strings.messageIntro.replace("{name}", name),
      strings.messageBusiness.replace("{business}", business),
      need && strings.messageNeed.replace("{need}", need),
      strings.messageAsk,
    ].filter(Boolean);

    window.open(
      `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(lines.join("\n"))}`,
      "_blank",
      "noopener",
    );
  });
</script>
