---
import {
  closing,
  site,
  WHATSAPP_NUMBER,
  whatsappConfigured,
} from "~/data/site";
import SectionLabel from "./SectionLabel.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
---

<!--
  Warm wash rather than a second dark band — the prices already used that card,
  and two dark blocks near each other flatten the rhythm of the page.
-->
<section id="contact" class="bg-accent-wash scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid gap-14 lg:grid-cols-[1fr_0.85fr] lg:gap-20">
      <div data-reveal>
        <SectionLabel
          number="04"
          label="Get started"
          heading={closing.heading}
        />

        <p class="text-muted mt-6 max-w-lg text-lg">{closing.body}</p>

        <div class="mt-9">
          <WhatsAppButton label={closing.cta} />
        </div>

        {
          site.email && (
            <p class="text-subtle border-line mt-10 border-t pt-6 text-sm">
              Prefer email?{" "}
              <a
                href={`mailto:${site.email}`}
                class="text-fg hover:text-accent font-medium underline underline-offset-4"
              >
                {site.email}
              </a>
            </p>
          )
        }
      </div>

      <!--
        A backup for people who freeze at an empty chat box: fill three fields
        and the button writes the WhatsApp message for them. No server, no form
        service, nothing to break — it just builds a wa.me link.
      -->
      <div
        class="border-line bg-surface h-fit rounded-[14px] border p-7 shadow-sm"
        data-reveal
      >
        <h3 class="font-display text-2xl">Not sure what to say?</h3>
        <p class="text-muted mt-2 text-sm">
          Fill these in and I'll write the message for you — you just hit send.
        </p>

        <form id="message-builder" class="mt-6 space-y-4" novalidate>
          <div>
            <label for="mb-name" class="block text-sm font-medium"
              >Your name</label
            >
            <input
              id="mb-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class="border-line bg-paper focus:border-accent mt-1.5 w-full rounded-lg border px-3.5 py-2.5"
              placeholder="Sam"
            />
          </div>

          <div>
            <label for="mb-business" class="block text-sm font-medium">
              What's your business?
            </label>
            <input
              id="mb-business"
              name="business"
              type="text"
              required
              class="border-line bg-paper focus:border-accent mt-1.5 w-full rounded-lg border px-3.5 py-2.5"
              placeholder="A small pizzeria in town"
            />
          </div>

          <div>
            <label for="mb-need" class="block text-sm font-medium">
              What do you need? <span class="text-subtle">(optional)</span>
            </label>
            <textarea
              id="mb-need"
              name="need"
              rows="3"
              class="border-line bg-paper focus:border-accent mt-1.5 w-full resize-y rounded-lg border px-3.5 py-2.5"
              placeholder="Somewhere to put the menu and take table bookings"
            ></textarea>
          </div>

          <p
            id="mb-error"
            role="alert"
            hidden
            class="text-accent text-sm font-medium"
          >
          </p>

          <button
            type="submit"
            class="bg-fg hover:bg-accent min-h-11 w-full rounded-full px-6 py-3.5 font-semibold text-white transition-colors"
          >
            Write my message
          </button>

          <p class="text-subtle text-xs">
            This opens WhatsApp with the message already typed. Nothing is sent
            until you press send there.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ WHATSAPP_NUMBER, whatsappConfigured }}>
  const form = document.getElementById("message-builder");
  const error = document.getElementById("mb-error");

  const fail = (message) => {
    error.textContent = message;
    error.hidden = false;
  };

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    error.hidden = true;

    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const business = String(data.get("business") || "").trim();
    const need = String(data.get("need") || "").trim();

    if (!name || !business) {
      fail("Please fill in your name and what your business is.");
      (name ? form.elements.business : form.elements.name).focus();
      return;
    }

    if (!whatsappConfigured) {
      fail("WhatsApp isn't set up on this site yet.");
      return;
    }

    const lines = [
      `Hi, I'm ${name}.`,
      `I run ${business}.`,
      need && `What I need: ${need}`,
      "Could you tell me what a website would cost?",
    ].filter(Boolean);

    window.open(
      `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(lines.join("\n"))}`,
      "_blank",
      "noopener",
    );
  });
</script>
