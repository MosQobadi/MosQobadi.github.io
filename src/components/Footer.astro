---
import { content, site } from "~/data";
import type { Locale } from "~/i18n/config";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = "/" } = Astro.props;
const t = content[locale].footer;
const year = new Date().getFullYear();
---

<footer class="border-line bg-canvas-alt border-t py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 px-5 sm:px-8 lg:flex-row lg:items-end lg:justify-between"
  >
    <div>
      <div class="flex items-center gap-2.5">
        <span
          aria-hidden="true"
          class="bg-fg text-canvas grid h-8 w-8 place-items-center rounded-lg font-mono text-[0.8125rem] font-semibold"
        >
          MQ
        </span>
        <span class="font-semibold tracking-tight">{site.name}</span>
      </div>
      <p class="text-muted mt-4 max-w-sm text-sm leading-relaxed">
        {t.tagline}
      </p>
    </div>

    <div class="flex flex-col gap-4 lg:items-end">
      <LangSwitch locale={locale} path={path} />
      <p class="text-subtle text-sm">
        {t.builtWith} © {year}
      </p>
    </div>
  </div>
</footer>
