---
import { site } from "~/data/site";
import WhatsAppButton from "./WhatsAppButton.astro";

const links = [
  { href: "#work", label: "Work" },
  { href: "#pricing", label: "Pricing" },
  { href: "#process", label: "How it works" },
];
---

<header
  class="border-line/80 bg-paper/85 sticky top-0 z-50 border-b backdrop-blur-md"
>
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8"
  >
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <span
        aria-hidden="true"
        class="bg-accent grid h-8 w-8 place-items-center rounded-lg text-[0.9rem] font-bold text-white"
        >MQ</span
      >
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    <nav aria-label="Sections" class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-muted hover:bg-sunk hover:text-fg rounded-full px-3 py-2 text-sm font-medium transition-colors"
          >
            {link.label}
          </a>
        ))
      }
      <WhatsAppButton
        label="Message me"
        size="md"
        class="ml-1 hidden md:inline-flex"
      />
    </nav>
  </div>
</header>
