---
import { hero } from "~/data/site";
import WhatsAppButton from "./WhatsAppButton.astro";
---

<section class="border-line relative overflow-hidden border-b">
  <!-- Soft warm glow behind the headline. Decorative only. -->
  <div
    aria-hidden="true"
    class="bg-accent-wash pointer-events-none absolute -top-40 left-1/2 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full blur-3xl"
  >
  </div>

  <div
    class="relative mx-auto max-w-4xl px-5 py-20 text-center sm:px-8 sm:py-28"
  >
    <h1
      class="text-[2.1rem] leading-[1.1] font-bold sm:text-5xl lg:text-[3.5rem]"
    >
      {hero.valueProp}
    </h1>

    <p class="text-muted mx-auto mt-6 max-w-xl text-lg sm:text-xl">
      {hero.support}
    </p>

    <div class="mt-9 flex justify-center">
      <WhatsAppButton label={hero.cta} />
    </div>

    <ul
      class="text-subtle mx-auto mt-9 flex max-w-2xl flex-wrap justify-center gap-x-6 gap-y-2 text-sm"
    >
      {
        hero.points.map((point) => (
          <li class="flex items-center gap-2">
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="text-accent h-4 w-4 shrink-0"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.53a.75.75 0 0 0-1.22-.87l-3.24 4.53-1.62-1.62a.75.75 0 0 0-1.06 1.06l2.24 2.24a.75.75 0 0 0 1.14-.094l3.76-5.25Z"
                clip-rule="evenodd"
              />
            </svg>
            {point}
          </li>
        ))
      }
    </ul>
  </div>
</section>
