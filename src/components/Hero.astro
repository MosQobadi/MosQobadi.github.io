---
import { hero } from "~/data/site";
import WhatsAppButton from "./WhatsAppButton.astro";
---

<section class="border-line relative overflow-hidden border-b">
  <!--
    A single warm wash bleeding in from the top right. One soft shape, off to
    one side — not the centred pink halo every template ships with.
  -->
  <div
    aria-hidden="true"
    class="bg-accent-wash pointer-events-none absolute -top-56 -right-40 h-[42rem] w-[42rem] rounded-full blur-3xl"
  >
  </div>

  <div
    class="relative mx-auto max-w-6xl px-5 pt-20 pb-16 sm:px-8 sm:pt-28 sm:pb-20"
  >
    <p class="text-subtle text-xs font-semibold tracking-[0.18em] uppercase">
      Web design · Available now
    </p>

    <h1
      class="font-display mt-7 max-w-[16ch] text-[3rem] leading-[1.0] sm:text-[4.25rem] lg:text-[5.25rem]"
    >
      {hero.valueProp}
    </h1>

    <p class="text-muted mt-8 max-w-xl text-lg sm:text-xl">
      {hero.support}
    </p>

    <!--
      CTA and the three reassurances share a rule. On a phone they stack; from
      `md` up the points sit to the right of the button, which keeps the fold
      short enough that the first work sample is nearly visible.
    -->
    <div
      class="border-line mt-12 flex flex-col gap-8 border-t pt-8 md:flex-row md:items-center md:justify-between"
    >
      <WhatsAppButton label={hero.cta} />

      <ul class="grid gap-3 sm:grid-cols-3 md:max-w-xl">
        {
          hero.points.map((point) => (
            <li class="text-muted flex items-start gap-2.5 text-[0.9375rem]">
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="text-accent mt-1 h-3.5 w-3.5 shrink-0"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z"
                  clip-rule="evenodd"
                />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
