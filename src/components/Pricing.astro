---
import { tiers, pricingNote, afterLaunchNote } from "~/data/site";
import SectionLabel from "./SectionLabel.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
---

<!--
  The one dark band on the page. Prices are the moment a stranger decides
  whether you are expensive, so they get the weight of a change in ground
  colour rather than another white card on white.
-->
<section
  id="pricing"
  class="bg-night text-night-fg scroll-mt-24 py-20 sm:py-28"
>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionLabel
      number="02"
      label="Services & pricing"
      heading="One number, agreed before I start."
      standfirst="Three packages, each a fixed price. No hourly billing, and no surprise invoice at the end."
      onDark
      data-reveal
    />

    <ul class="mt-14 grid items-start gap-6 lg:grid-cols-3" data-reveal>
      {
        tiers.map((tier) => (
          <li
            class:list={[
              "relative flex h-full flex-col rounded-[14px] p-8",
              tier.featured
                ? "border-accent-on-dark bg-night-surface border"
                : "border-night-line border",
            ]}
          >
            {tier.featured && (
              <span class="bg-accent-on-dark text-night absolute -top-3 left-8 rounded-full px-3 py-1 text-[0.7rem] font-bold tracking-wide uppercase">
                Most popular
              </span>
            )}

            <h3 class="text-night-muted text-xs font-semibold tracking-[0.18em] uppercase">
              {tier.name}
            </h3>

            {/* Fixed height so the delivery rule lands on the same line in all
                three cards — only Pro carries a price note, and without this
                its whole lower half sits lower than its neighbours'. */}
            <div class="lg:min-h-[10.5rem]">
              <p class="font-display tabular mt-5 text-5xl leading-none">
                {tier.price}
              </p>

              {tier.priceNote && (
                <p class="text-night-muted mt-3 text-[0.8125rem]">
                  {tier.priceNote}
                </p>
              )}

              <p class="mt-4 text-[0.9375rem] text-white/80">{tier.suits}</p>
            </div>

            <p class="text-night-muted border-night-line mt-6 flex items-center gap-2 border-t pt-6 text-sm font-medium">
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-4 w-4"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .3.16.56.42.68l3 1.5a.75.75 0 1 0 .66-1.34l-2.58-1.3V5Z"
                  clip-rule="evenodd"
                />
              </svg>
              {tier.delivery}
            </p>

            <ul class="border-night-line mt-6 flex-1 space-y-3 border-t pt-6">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-[0.9375rem]">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="text-accent-on-dark mt-1 h-3.5 w-3.5 shrink-0"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="text-white/85">{feature}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <div
      class="border-night-line mt-12 flex flex-col gap-6 border-t pt-8 sm:flex-row sm:items-end sm:justify-between"
      data-reveal
    >
      <div class="max-w-xl space-y-2 text-[0.9375rem]">
        <p class="font-semibold">{pricingNote}</p>
        <p class="text-night-muted">{afterLaunchNote}</p>
        <p class="text-night-muted">
          Not sure which one fits? Describe your business and I'll tell you
          honestly — often it's the cheapest one.
        </p>
      </div>
      <WhatsAppButton
        label="Ask which package fits"
        variant="onDark"
        size="md"
        class="shrink-0"
      />
    </div>
  </div>
</section>
