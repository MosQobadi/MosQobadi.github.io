---
import { content, tierMeta, tierOrder, workMedia } from "~/data";
import type { TierId } from "~/data";
import type { Locale } from "~/i18n/config";
import SectionLabel from "./SectionLabel.astro";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].pricing;
const samples = content[locale].work.samples;

/*
 * The three website packages sit in a row; the custom track gets its own wide
 * card underneath. Splitting them is the point — four equal columns would read
 * as "four sizes of website", which is exactly the impression the capabilities
 * section above just spent a paragraph correcting.
 */
const packageIds = tierOrder.filter((id) => !tierMeta[id].isCustom);
const customIds = tierOrder.filter((id) => tierMeta[id].isCustom);

/** The demo that shows what a package produces, if one has been built yet. */
function example(id: TierId) {
  const workId = tierMeta[id].example;
  if (!workId) return null;
  return { href: workMedia[workId].href, name: samples[workId].name };
}
---

<section id="pricing" class="border-line scroll-mt-24 border-b py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionLabel
      number="03"
      label={t.label}
      heading={t.heading}
      standfirst={t.standfirst}
      data-reveal
    />

    <ul class="mt-12 grid items-start gap-5 lg:grid-cols-3" data-reveal>
      {
        packageIds.map((id) => {
          const tier = t.tiers[id];
          const meta = tierMeta[id];
          const link = example(id);
          return (
            <li
              class:list={[
                "card relative flex h-full flex-col p-7",
                meta.featured &&
                  "border-accent shadow-[0_20px_50px_-24px_var(--color-accent)]",
              ]}
            >
              {meta.featured && (
                <span class="eyebrow bg-accent text-accent-fg absolute -top-3 left-7 rounded-full px-3 py-1 text-[0.65rem]">
                  {t.popular}
                </span>
              )}

              <h3 class="eyebrow text-subtle">{tier.name}</h3>

              {/* Fixed height so the delivery rule lands on the same line in
                  all three cards — only Pro carries a price note, and without
                  this its whole lower half sits lower than its neighbours'. */}
              <div class="lg:min-h-[9.5rem]">
                <p class="display tabular mt-4 text-[2.75rem]">{tier.price}</p>

                {tier.priceNote && (
                  <p class="text-subtle mt-3 text-[0.8125rem] leading-relaxed">
                    {tier.priceNote}
                  </p>
                )}

                <p class="text-muted mt-3 text-[0.9375rem] leading-relaxed">
                  {tier.suits}
                </p>
              </div>

              <p class="text-muted border-line mt-6 flex items-center gap-2 border-t pt-5 font-mono text-xs">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-4 w-4"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .3.16.56.42.68l3 1.5a.75.75 0 1 0 .66-1.34l-2.58-1.3V5Z"
                    clip-rule="evenodd"
                  />
                </svg>
                {tier.delivery}
              </p>

              <ul class="border-line mt-5 flex-1 space-y-3 border-t pt-5">
                {tier.features.map((feature) => (
                  <li class="text-muted flex items-start gap-2.5 text-[0.9375rem]">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="text-accent mt-[0.2rem] h-4 w-4 shrink-0"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>

              {/*
               * The proof that sits under the price. A package with a live
               * example beside it is a different proposition from a package
               * with a number and a list, so when one hasn't been built yet
               * the card says so plainly instead of linking nowhere.
               */}
              <div class="border-line mt-6 border-t pt-5">
                {link ? (
                  <a
                    href={link.href}
                    class="text-accent group inline-flex items-center gap-1.5 text-[0.9375rem] font-medium"
                  >
                    {t.exampleLink}
                    <span class="text-subtle font-normal">— {link.name}</span>
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M3 10a.75.75 0 0 1 .75-.75h10.19L10.7 6.28a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.24-2.97H3.75A.75.75 0 0 1 3 10Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </a>
                ) : (
                  <span class="text-subtle inline-flex items-center gap-2 font-mono text-xs">
                    <span
                      aria-hidden="true"
                      class="bg-line-strong h-1.5 w-1.5 rounded-full"
                    />
                    {t.examplePending}
                  </span>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>

    {
      customIds.map((id) => {
        const tier = t.tiers[id];
        const link = example(id);
        return (
          <div
            class="card bg-canvas-alt mt-5 grid gap-8 p-7 sm:p-9 lg:grid-cols-[1fr_1.15fr]"
            data-reveal
          >
            <div>
              <h3 class="eyebrow text-subtle">{tier.name}</h3>
              <p class="display mt-4 text-[2.25rem]">{tier.price}</p>
              <p class="text-muted mt-3 text-[0.9375rem] leading-relaxed">
                {tier.suits}
              </p>
              {tier.priceNote && (
                <p class="text-subtle mt-3 text-[0.8125rem] leading-relaxed">
                  {tier.priceNote}
                </p>
              )}
              <p class="text-muted border-line mt-6 flex items-center gap-2 border-t pt-5 font-mono text-xs">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-4 w-4"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .3.16.56.42.68l3 1.5a.75.75 0 1 0 .66-1.34l-2.58-1.3V5Z"
                    clip-rule="evenodd"
                  />
                </svg>
                {tier.delivery}
              </p>
            </div>

            <div class="flex flex-col">
              <ul class="grid flex-1 gap-3 sm:grid-cols-2">
                {tier.features.map((feature) => (
                  <li class="text-muted flex items-start gap-2.5 text-[0.9375rem]">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="text-accent mt-[0.2rem] h-4 w-4 shrink-0"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>

              {link && (
                <div class="border-line mt-6 border-t pt-5">
                  <a
                    href={link.href}
                    target={link.href.startsWith("http") ? "_blank" : null}
                    rel={link.href.startsWith("http") ? "noopener" : null}
                    class="text-accent group inline-flex items-center gap-1.5 text-[0.9375rem] font-medium"
                  >
                    {t.exampleLink}
                    <span class="text-subtle font-normal">— {link.name}</span>
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M3 10a.75.75 0 0 1 .75-.75h10.19L10.7 6.28a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.24-2.97H3.75A.75.75 0 0 1 3 10Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      })
    }

    <div
      class="border-line mt-12 flex flex-col gap-6 border-t pt-8 sm:flex-row sm:items-end sm:justify-between"
      data-reveal
    >
      <div class="text-muted max-w-xl space-y-2 text-[0.9375rem]">
        <p class="text-fg font-medium">{t.note}</p>
        <p>{t.afterLaunch}</p>
        <p>{t.help}</p>
      </div>
      <WhatsAppButton
        locale={locale}
        label={t.cta}
        variant="outline"
        size="md"
        class="shrink-0"
      />
    </div>
  </div>
</section>
