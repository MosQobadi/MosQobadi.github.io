---
import { tiers, pricingNote, afterLaunchNote } from "~/data/site";
import WhatsAppButton from "./WhatsAppButton.astro";
---

<section id="pricing" class="border-line scroll-mt-24 border-b py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <h2 class="text-3xl font-bold sm:text-4xl">What it costs</h2>
    <p class="text-muted mt-3 max-w-2xl text-lg">
      Three packages, each a fixed price. You'll know the total before I start —
      no hourly billing, no surprise invoice at the end.
    </p>

    <ul class="mt-12 grid items-start gap-6 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <li
            class:list={[
              "bg-surface relative flex h-full flex-col rounded-[14px] p-7",
              tier.featured
                ? "border-accent shadow-accent/10 border-2 shadow-lg lg:-mt-3 lg:pt-9 lg:pb-9"
                : "border-line border",
            ]}
          >
            {tier.featured && (
              <span class="bg-accent absolute -top-3 left-7 rounded-full px-3 py-1 text-[0.7rem] font-bold tracking-wide text-white uppercase">
                Most popular
              </span>
            )}

            <h3 class="text-subtle text-lg font-semibold tracking-wide uppercase">
              {tier.name}
            </h3>

            <p class="mt-3 text-4xl font-bold tracking-tight">{tier.price}</p>
            {tier.priceNote && (
              <p class="text-subtle mt-1.5 text-[0.8125rem]">
                {tier.priceNote}
              </p>
            )}
            <p class="text-muted mt-2">{tier.suits}</p>

            <p class="bg-sunk text-muted mt-4 inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium">
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="text-subtle h-4 w-4"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .3.16.56.42.68l3 1.5a.75.75 0 1 0 .66-1.34l-2.58-1.3V5Z"
                  clip-rule="evenodd"
                />
              </svg>
              {tier.delivery}
            </p>

            <ul class="border-line mt-6 flex-1 space-y-3 border-t pt-6">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-[0.9375rem]">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="text-accent mt-0.5 h-4 w-4 shrink-0"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <div
      class="border-line bg-sunk mt-10 flex flex-col items-start gap-5 rounded-[14px] border px-6 py-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-muted text-[0.9375rem]">
        <strong class="text-fg font-semibold">{pricingNote}</strong><br />
        {afterLaunchNote}<br />
        Not sure which one fits? Describe your business and I'll tell you honestly
        — often it's the cheapest one.
      </p>
      <WhatsAppButton
        label="Ask which package fits"
        size="md"
        class="shrink-0"
      />
    </div>
  </div>
</section>
