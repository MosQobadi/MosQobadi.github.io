---
import { steps } from "~/data/site";
import SectionLabel from "./SectionLabel.astro";
---

<section id="process" class="border-line scroll-mt-24 border-b py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionLabel
      number="03"
      label="How it works"
      heading="Four steps, and you only do the first."
      data-reveal
    />

    <!--
      Numbers set in the display serif and hung on a hairline, rather than the
      circled digits every process section uses. Each step is its own column
      with its own rule, so the row reads as a sequence.

      They are deliberately NOT accent-coloured: the four section markers
      (01-04) already own red numerals, and two sets of red numbers on one
      page reads as one broken sequence rather than two deliberate ones.
    -->
    <ol
      class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4"
      data-reveal
    >
      {
        steps.map((step, index) => (
          <li class="border-line border-t pt-6">
            <span
              aria-hidden="true"
              class="font-display text-line-strong block text-4xl leading-none"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-5 text-lg font-semibold">{step.title}</h3>
            <p class="text-muted mt-2.5 text-[0.9375rem]">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
