---
/**
 * Fades sections up as they arrive.
 *
 * The important part of this file is everything that stops it hiding content.
 * A scroll animation that fails leaves a blank page, and this site is the only
 * thing a prospective customer sees — so it is built so that every failure
 * mode ends with the content visible:
 *
 *   - the class is added by script, so with JavaScript off nothing is hidden;
 *   - no IntersectionObserver, or reduced motion, and nothing is hidden;
 *   - a zero-height or hidden viewport at load, and nothing is hidden — this
 *     is the real one, because links from Facebook open in an in-app browser
 *     that can lay out late;
 *   - and if the observer simply never fires for any other reason, a timer
 *     reveals everything anyway.
 *
 * Only elements below the fold are hidden to begin with. Animating something
 * already on screen just makes it flash.
 */
---

<script>
  const targets = Array.from(
    document.querySelectorAll<HTMLElement>("[data-reveal]"),
  );

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const canAnimate =
    targets.length > 0 &&
    "IntersectionObserver" in window &&
    !prefersReducedMotion &&
    /* A viewport with no height means layout hasn't happened yet. Hiding
       against it would hide the whole page with nothing to trigger it back. */
    window.innerHeight > 0 &&
    document.visibilityState !== "hidden";

  if (canAnimate) {
    const fold = window.innerHeight * 0.9;
    const hidden = targets.filter(
      (element) => element.getBoundingClientRect().top > fold,
    );

    const show = (element: HTMLElement) => element.classList.add("is-visible");

    hidden.forEach((element) => element.classList.add("reveal"));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          show(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        });
      },
      /* Fire a little before the element reaches the fold, so the movement has
         finished by the time it is properly in view. */
      { rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
    );

    hidden.forEach((element) => observer.observe(element));

    /* The failsafe. Two seconds is long enough that a normal scroll has
       already revealed things naturally, and short enough that a reader who
       hit a broken case never notices there was one. */
    window.setTimeout(() => {
      hidden.forEach(show);
      observer.disconnect();
    }, 2000);
  }
</script>
