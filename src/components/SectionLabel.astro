---
/**
 * The device the whole page hangs on: a hairline rule with a numbered label
 * sitting on it, then the section's real heading.
 *
 * It's what turns five stacked blocks into five chapters. Used on every
 * section, always in the same order, always with the number.
 */

interface Props {
  /** "01", "02" … Always two digits; a bare "1" looks like a typo here. */
  number: string;
  /** The small monospaced label on the rule. */
  label: string;
  heading: string;
  /** Optional standfirst under the heading. */
  standfirst?: string;
  class?: string;
  /**
   * Anything else — in practice `data-reveal`, which every caller passes.
   * Astro does NOT forward unknown props to the DOM, so without this spread
   * the attribute lands on the component and is quietly dropped, and the
   * section headings are the only things on the page that never animate in.
   */
  [key: `data-${string}`]: unknown;
}

const {
  number,
  label,
  heading,
  standfirst,
  class: className = "",
  ...rest
} = Astro.props;
---

<header class={className || undefined} {...rest}>
  <div class="border-line flex items-center gap-3 border-t pt-4">
    <span class="eyebrow text-accent tabular">{number}</span>
    <span aria-hidden="true" class="bg-line-strong h-3 w-px"></span>
    <span class="eyebrow text-subtle">{label}</span>
  </div>

  <h2
    class="display mt-7 max-w-[20ch] text-[2.25rem] sm:text-5xl lg:text-[3.5rem]"
  >
    {heading}
  </h2>

  {
    standfirst && (
      <p class="text-muted mt-5 max-w-2xl text-lg leading-relaxed">
        {standfirst}
      </p>
    )
  }
</header>
