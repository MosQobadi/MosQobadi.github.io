---
import { Image } from "astro:assets";
import { workSamples } from "~/data/site";
import SectionLabel from "./SectionLabel.astro";

/*
 * One sample takes the wide feature slot and the rest share a row beneath.
 * Which one is a content decision, not a code one — it is the `featured` flag
 * in site.ts, because the right answer changes with whichever sample currently
 * has the best screenshot.
 */
const feature = workSamples.find((sample) => sample.featured) ?? workSamples[0];
const rest = workSamples.filter((sample) => sample !== feature);

const isExternal = (href: string) => href.startsWith("http");
---

<section id="work" class="border-line scroll-mt-24 border-b py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionLabel
      number="01"
      label="Recent work"
      heading="Sites that are open right now."
      standfirst="One live client site, and three I built myself to show what each kind of business site looks like. Every one of them opens — have a click around."
      data-reveal
    />

    <!-- Feature -->
    <a
      href={feature.href}
      target={isExternal(feature.href) ? "_blank" : null}
      rel={isExternal(feature.href) ? "noopener" : null}
      class="group border-line bg-surface hover:border-line-strong mt-14 grid overflow-hidden rounded-[14px] border transition-all hover:shadow-xl hover:shadow-black/5 lg:grid-cols-[1.35fr_1fr]"
      data-reveal
    >
      <div
        class="border-line bg-sunk overflow-hidden border-b lg:border-r lg:border-b-0"
      >
        <Image
          src={feature.image}
          alt={feature.imageAlt}
          widths={[600, 1000, 1400]}
          sizes="(min-width: 1024px) 55vw, 92vw"
          class="aspect-[8/5] w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.02]"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="flex flex-col justify-center p-7 sm:p-10">
        <div class="flex flex-wrap items-center gap-3">
          <h3 class="font-display text-3xl">{feature.name}</h3>
          {
            feature.isDemo ? (
              <span class="border-line-strong text-subtle rounded-full border px-2.5 py-1 text-[0.7rem] font-semibold tracking-wide uppercase">
                Demo I built
              </span>
            ) : (
              <span class="bg-accent-wash text-accent rounded-full px-2.5 py-1 text-[0.7rem] font-semibold tracking-wide uppercase">
                Live client site
              </span>
            )
          }
        </div>

        <p class="text-muted mt-4 text-lg">{feature.problem}</p>

        <ul class="mt-6 flex flex-wrap gap-2">
          {
            feature.features.map((item) => (
              <li class="border-line text-muted rounded-md border px-2.5 py-1 text-[0.8125rem]">
                {item}
              </li>
            ))
          }
        </ul>

        <span
          class="text-accent mt-8 inline-flex items-center gap-1.5 font-semibold"
        >
          {isExternal(feature.href) ? "Visit the live site" : "Open the demo"}
          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
          >
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.19L10.7 6.28a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.24-2.97H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"></path>
          </svg>
        </span>
      </div>
    </a>

    <!-- The three demos -->
    <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        rest.map((sample) => (
          <li class="flex">
            <a
              href={sample.href}
              target={isExternal(sample.href) ? "_blank" : null}
              rel={isExternal(sample.href) ? "noopener" : null}
              class="group border-line bg-surface hover:border-line-strong flex w-full flex-col overflow-hidden rounded-[14px] border transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-black/5"
            >
              <div class="border-line bg-sunk overflow-hidden border-b">
                <Image
                  src={sample.image}
                  alt={sample.imageAlt}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                  class="aspect-[8/5] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>

              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap items-center gap-2.5">
                  <h3 class="font-display text-2xl">{sample.name}</h3>
                  {sample.isDemo ? (
                    <span class="border-line-strong text-subtle rounded-full border px-2 py-0.5 text-[0.65rem] font-semibold tracking-wide uppercase">
                      Demo
                    </span>
                  ) : (
                    <span class="bg-accent-wash text-accent rounded-full px-2 py-0.5 text-[0.65rem] font-semibold tracking-wide uppercase">
                      Live client
                    </span>
                  )}
                </div>

                <p class="text-muted mt-3 flex-1 text-[0.9375rem]">
                  {sample.problem}
                </p>

                <span class="text-accent mt-6 inline-flex items-center gap-1.5 text-[0.9375rem] font-semibold">
                  {isExternal(sample.href)
                    ? "Visit the live site"
                    : "Open the demo"}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-4 w-4 transition-transform group-hover:translate-x-1"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 0 1 .75-.75h10.19L10.7 6.28a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.24-2.97H3.75A.75.75 0 0 1 3 10Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <p
      class="text-muted border-line mt-10 flex items-start gap-3 border-t pt-6 text-sm"
      data-reveal
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="text-subtle mt-0.5 h-4 w-4 shrink-0"
      >
        <path
          fill-rule="evenodd"
          d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.25v2.25H9a.75.75 0 0 0 0 1.5h2a.75.75 0 0 0 0-1.5h-.25V9.75A.75.75 0 0 0 10 9H9Z"
          clip-rule="evenodd"></path>
      </svg>
      <span>
        <strong class="text-fg font-semibold">To be straight with you:</strong> the
        three demos are businesses I made up, built to show what I can do rather than
        for paying clients. Top Oil is a real, live site.
      </span>
    </p>
  </div>
</section>
