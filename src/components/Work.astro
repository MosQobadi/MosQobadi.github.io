---
import { Image } from "astro:assets";
import { content, workMedia, workOrder } from "~/data";
import type { WorkId } from "~/data";
import type { Locale } from "~/i18n/config";
import SectionLabel from "./SectionLabel.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].work;

/*
 * One sample takes the wide feature slot and the rest share a row beneath.
 * Which one is a content decision, not a code one — it is the `featured` flag
 * in shared.ts, because the right answer changes with whichever sample
 * currently has the best screenshot.
 */
const featuredId: WorkId =
  workOrder.find((id) => workMedia[id].featured) ?? workOrder[0];
const restIds = workOrder.filter((id) => id !== featuredId);

const isExternal = (href: string) => href.startsWith("http");
---

<section id="work" class="border-line scroll-mt-24 border-b py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionLabel
      number="01"
      label={t.label}
      heading={t.heading}
      standfirst={t.standfirst}
      data-reveal
    />

    {
      (() => {
        const media = workMedia[featuredId];
        const copy = t.samples[featuredId];
        const external = isExternal(media.href);
        return (
          <a
            href={media.href}
            target={external ? "_blank" : null}
            rel={external ? "noopener" : null}
            class="card card-interactive group mt-12 grid overflow-hidden lg:grid-cols-[1.3fr_1fr]"
            data-reveal
          >
            <div class="border-line bg-sunk overflow-hidden border-b lg:border-r lg:border-b-0">
              <Image
                src={media.image}
                alt={copy.imageAlt}
                widths={[600, 1000, 1400]}
                sizes="(min-width: 1024px) 55vw, 92vw"
                class="aspect-[8/5] w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.02]"
                loading="eager"
                fetchpriority="high"
              />
            </div>

            <div class="flex flex-col justify-center p-7 sm:p-9">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="display-sm text-3xl">{copy.name}</h3>
                <span
                  class:list={[
                    "eyebrow rounded-full px-2.5 py-1 text-[0.65rem]",
                    media.isDemo
                      ? "border-line-strong text-subtle border"
                      : "bg-accent-wash text-accent",
                  ]}
                >
                  {media.isDemo ? t.badgeDemo : t.badgeLive}
                </span>
              </div>

              <p class="text-muted mt-4 leading-relaxed">{copy.problem}</p>

              <ul class="mt-6 flex flex-wrap gap-2">
                {copy.features.map((item) => (
                  <li class="border-line text-muted rounded-md border px-2.5 py-1 font-mono text-xs">
                    {item}
                  </li>
                ))}
              </ul>

              <span class="text-accent mt-8 inline-flex items-center gap-1.5 text-[0.9375rem] font-medium">
                {external ? t.visitLive : t.openDemo}
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-4 w-4 transition-transform group-hover:translate-x-1"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 0 1 .75-.75h10.19L10.7 6.28a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.24-2.97H3.75A.75.75 0 0 1 3 10Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </span>
            </div>
          </a>
        );
      })()
    }

    <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        restIds.map((id) => {
          const media = workMedia[id];
          const copy = t.samples[id];
          const external = isExternal(media.href);
          return (
            <li class="flex">
              <a
                href={media.href}
                target={external ? "_blank" : null}
                rel={external ? "noopener" : null}
                class="card card-interactive group flex w-full flex-col overflow-hidden"
              >
                <div class="border-line bg-sunk overflow-hidden border-b">
                  <Image
                    src={media.image}
                    alt={copy.imageAlt}
                    widths={[400, 700, 1000]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                    class="aspect-[8/5] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>

                <div class="flex flex-1 flex-col p-6">
                  <div class="flex flex-wrap items-center gap-2.5">
                    <h3 class="display-sm text-xl">{copy.name}</h3>
                    <span
                      class:list={[
                        "eyebrow rounded-full px-2 py-0.5 text-[0.6rem]",
                        media.isDemo
                          ? "border-line-strong text-subtle border"
                          : "bg-accent-wash text-accent",
                      ]}
                    >
                      {media.isDemo ? t.badgeDemo : t.badgeLive}
                    </span>
                  </div>

                  <p class="text-muted mt-3 flex-1 text-[0.9375rem] leading-relaxed">
                    {copy.problem}
                  </p>

                  <span class="text-accent mt-6 inline-flex items-center gap-1.5 text-[0.9375rem] font-medium">
                    {external ? t.visitLive : t.openDemo}
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M3 10a.75.75 0 0 1 .75-.75h10.19L10.7 6.28a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.24-2.97H3.75A.75.75 0 0 1 3 10Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    <p
      class="text-muted border-line mt-10 flex items-start gap-3 border-t pt-6 text-sm"
      data-reveal
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="text-subtle mt-0.5 h-4 w-4 shrink-0"
      >
        <path
          fill-rule="evenodd"
          d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.25v2.25H9a.75.75 0 0 0 0 1.5h2a.75.75 0 0 0 0-1.5h-.25V9.75A.75.75 0 0 0 10 9H9Z"
          clip-rule="evenodd"></path>
      </svg>
      <span>
        <strong class="text-fg font-semibold">{t.disclosureLead}</strong>{" "}
        {t.disclosureBody}
      </span>
    </p>
  </div>
</section>
