---
/**
 * The homepage, once. `src/pages/index.astro` and `src/pages/fr/index.astro`
 * are three lines each and both render this — so a section added here appears
 * in both languages, and the two pages cannot drift apart.
 */
import Base from "./Base.astro";
import Header from "~/components/Header.astro";
import Hero from "~/components/Hero.astro";
import Work from "~/components/Work.astro";
import Capabilities from "~/components/Capabilities.astro";
import Pricing from "~/components/Pricing.astro";
import Process from "~/components/Process.astro";
import Closing from "~/components/Closing.astro";
import Footer from "~/components/Footer.astro";
import Reveal from "~/components/Reveal.astro";
import { content, site } from "~/data";
import type { Locale } from "~/i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<Base
  locale={locale}
  title={`${site.name} — ${t.meta.title}`}
  description={t.meta.description}
>
  <a href="#main" class="skip-link">{t.nav.skip}</a>
  <Header locale={locale} path="/" />
  <main id="main">
    <Hero locale={locale} />
    <Work locale={locale} />
    <Capabilities locale={locale} />
    <Pricing locale={locale} />
    <Process locale={locale} />
    <Closing locale={locale} />
  </main>
  <Footer locale={locale} path="/" />
  <Reveal />
</Base>
