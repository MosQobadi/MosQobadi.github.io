---
import "@fontsource-variable/plus-jakarta-sans";
import Base from "~/layouts/Base.astro";
import DemoBanner from "~/components/DemoBanner.astro";
import {
  days,
  sessionsFor,
  readableTime,
  kindLabels,
  type ClassKind,
} from "~/data/demo-gym";

/* ── Demo content ─────────────────────────────────────────────────────────
 * A made-up fitness studio. The reason a studio needs a website at all is the
 * timetable — it otherwise lives in an Instagram story that vanishes in 24
 * hours — so the week goes above everything else on the page.
 * ─────────────────────────────────────────────────────────────────────── */

const studio = {
  name: "Cadence Fitness",
  strapline: "Small classes. Real coaching. No lock-in.",
  headline: "Twelve people, one coach, forty-five minutes.",
  blurb:
    "A small studio off Wexford Avenue. Classes cap at twelve so somebody actually watches your technique, and nobody here will sell you a two-year contract.",
  address: "Unit 4, 118 Wexford Avenue",
  phone: "(555) 214-8890",
};

const classTypes: { kind: ClassKind; blurb: string; detail: string }[] = [
  {
    kind: "strength",
    blurb: "Barbell work — squat, press, hinge, pull.",
    detail:
      "Numbered levels, so Strength 1 assumes nothing and Strength 2 assumes you've done Strength 1.",
  },
  {
    kind: "conditioning",
    blurb: "Intervals, rowing, bikes, carries.",
    detail:
      "Hard, short, scaled to whoever turns up. Nobody is left behind the group.",
  },
  {
    kind: "mobility",
    blurb: "Slow, unglamorous, the reason you keep training.",
    detail:
      "Hips, shoulders, ankles. Most people arrive here after something twinges.",
  },
];

const coaches = [
  {
    name: "Dee Whitlock",
    role: "Head coach — strength",
    bio: "Fifteen years under a barbell and eight coaching it. Will make you take a plate off before adding one.",
  },
  {
    name: "Ravi Anand",
    role: "Conditioning",
    bio: "Ex-800m runner. Believes the last two minutes are where the session actually happens.",
  },
  {
    name: "Marta Lindqvist",
    role: "Mobility & rehab",
    bio: "Physio background. The one you see when your shoulder starts making that noise.",
  },
];

const memberships = [
  {
    name: "Drop-in",
    price: "$22",
    per: "a class",
    note: "Turn up, train, leave. No account, no commitment.",
  },
  {
    name: "10-class pass",
    price: "$180",
    per: "10 classes",
    note: "Valid four months. Share it with a partner if you like.",
    featured: true,
  },
  {
    name: "Unlimited",
    price: "$140",
    per: "a month",
    note: "Every class, every week. Cancel any month, no notice period.",
  },
];

/** Tailwind can't see a class name built at runtime, so map it here. */
const kindStyles: Record<ClassKind, string> = {
  strength: "bg-gym-lime text-gym-ink",
  conditioning: "bg-gym-accent text-white",
  mobility: "bg-gym-ink text-white",
};

const nav = [
  { href: "#timetable", label: "Timetable" },
  { href: "#classes", label: "Classes" },
  { href: "#coaches", label: "Coaches" },
  { href: "#membership", label: "Membership" },
];

const tel = studio.phone.replace(/\D/g, "");
---

<Base
  title={`${studio.name} — small-group fitness studio (demo site)`}
  description="Demo fitness studio website: a full weekly class timetable, coaches, membership prices and a free-trial booking form."
  noindex
  bodyClass="bg-gym-paper text-gym-ink font-trade"
>
  <a href="#main" class="skip-link">Skip to content</a>

  <div class="sticky top-0 z-50">
    <DemoBanner business={studio.name} />

    <header class="border-gym-line bg-gym-paper/95 border-b backdrop-blur-md">
      <div
        class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5"
      >
        <a href="#top" class="flex items-center gap-2.5">
          <span
            aria-hidden="true"
            class="bg-gym-lime text-gym-ink grid h-9 w-9 place-items-center rounded-lg text-sm font-extrabold"
            >CF</span
          >
          <span class="font-extrabold tracking-tight">{studio.name}</span>
        </a>

        <nav aria-label="Main" class="flex items-center gap-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="text-gym-muted hover:text-gym-ink hidden rounded px-3 py-2 text-sm font-semibold lg:inline-block"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="#trial"
            class="bg-gym-ink ml-1 inline-flex min-h-11 items-center rounded-lg px-4 py-2.5 text-sm font-bold text-white hover:opacity-90"
          >
            Free trial
          </a>
        </nav>
      </div>
    </header>
  </div>

  <main id="main">
    <!-- Hero -->
    <section id="top" class="bg-gym-ink relative overflow-hidden text-white">
      <div
        aria-hidden="true"
        class="bg-gym-lime/20 pointer-events-none absolute -top-32 -right-20 h-96 w-96 rounded-full blur-3xl"
      >
      </div>

      <div class="relative mx-auto max-w-6xl px-5 py-20 sm:py-24">
        <p class="text-gym-lime text-sm font-bold tracking-[0.22em] uppercase">
          {studio.strapline}
        </p>
        <h1
          class="mt-5 max-w-3xl text-4xl leading-[1.06] font-extrabold sm:text-6xl"
        >
          {studio.headline}
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/75">{studio.blurb}</p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="#trial"
            class="bg-gym-lime text-gym-ink inline-flex min-h-11 items-center rounded-lg px-7 py-3.5 font-bold hover:opacity-90"
          >
            Book a free trial class
          </a>
          <a
            href="#timetable"
            class="inline-flex min-h-11 items-center rounded-lg border border-white/25 px-7 py-3.5 font-bold hover:bg-white/10"
          >
            See this week
          </a>
        </div>

        <p id="today-line" class="mt-8 text-sm text-white/70">
          {studio.address} · {studio.phone}
        </p>
      </div>
    </section>

    <!-- Timetable: the reason this business needs a website -->
    <section id="timetable" class="scroll-mt-32 py-20">
      <div class="mx-auto max-w-6xl px-5">
        <div class="flex flex-wrap items-end justify-between gap-5">
          <div>
            <h2 class="text-3xl font-extrabold sm:text-4xl">This week</h2>
            <p class="text-gym-muted mt-3 max-w-xl text-lg">
              Same every week. Just turn up five minutes early for your first
              one.
            </p>
          </div>

          <ul class="flex flex-wrap gap-2" aria-label="Class types">
            {
              (Object.keys(kindLabels) as ClassKind[]).map((kind) => (
                <li
                  class:list={[
                    "rounded-full px-3 py-1.5 text-xs font-bold tracking-wide uppercase",
                    kindStyles[kind],
                  ]}
                >
                  {kindLabels[kind]}
                </li>
              ))
            }
          </ul>
        </div>

        <!--
          One column per day on a wide screen; the same markup stacks into
          day-by-day cards on a phone. A timetable is the one thing on a gym
          site people open on a phone at 6am, so it can't be a wide table that
          scrolls sideways.
        -->
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-7 lg:gap-3">
          {
            days.map((day) => {
              const sessions = sessionsFor(day.index);
              return (
                <section
                  data-day={day.index}
                  class="border-gym-line bg-gym-surface rounded-xl border p-3"
                >
                  <h3 class="border-gym-line flex items-baseline justify-between border-b pb-2 text-sm font-extrabold tracking-wide uppercase">
                    <span class="lg:hidden">{day.name}</span>
                    <span class="hidden lg:inline">{day.short}</span>
                    <span
                      data-today-flag
                      hidden
                      class="bg-gym-lime text-gym-ink rounded-full px-2 py-0.5 text-[0.65rem] font-bold"
                    >
                      Today
                    </span>
                  </h3>

                  {sessions.length === 0 ? (
                    <p class="text-gym-muted py-4 text-sm">Rest day.</p>
                  ) : (
                    <ul class="mt-3 space-y-2">
                      {sessions.map((session) => (
                        <li
                          class:list={[
                            "rounded-lg px-3 py-2.5",
                            kindStyles[session.kind],
                          ]}
                        >
                          <p class="text-sm font-extrabold">
                            {readableTime(session.start)}
                          </p>
                          <p class="text-sm font-semibold">{session.name}</p>
                          <p class="text-xs opacity-75">
                            {session.minutes} min · {session.coach}
                          </p>
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Classes -->
    <section
      id="classes"
      class="border-gym-line bg-gym-surface scroll-mt-32 border-y py-20"
    >
      <div class="mx-auto max-w-6xl px-5">
        <h2 class="text-3xl font-extrabold sm:text-4xl">
          What the classes are
        </h2>
        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {
            classTypes.map((type) => (
              <li class="border-gym-line bg-gym-paper rounded-2xl border p-6">
                <span
                  class:list={[
                    "inline-block rounded-full px-3 py-1.5 text-xs font-bold tracking-wide uppercase",
                    kindStyles[type.kind],
                  ]}
                >
                  {kindLabels[type.kind]}
                </span>
                <p class="mt-4 text-lg font-extrabold">{type.blurb}</p>
                <p class="text-gym-muted mt-2 text-[0.9375rem]">
                  {type.detail}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Coaches -->
    <section id="coaches" class="scroll-mt-32 py-20">
      <div class="mx-auto max-w-6xl px-5">
        <h2 class="text-3xl font-extrabold sm:text-4xl">Who's coaching</h2>
        <p class="text-gym-muted mt-3 max-w-xl text-lg">
          Three of us. You'll know all their names inside a fortnight.
        </p>

        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {
            coaches.map((coach) => (
              <li class="border-gym-line bg-gym-surface rounded-2xl border p-6">
                <span
                  aria-hidden="true"
                  class="bg-gym-lime text-gym-ink grid h-14 w-14 place-items-center rounded-full text-lg font-extrabold"
                >
                  {coach.name
                    .split(" ")
                    .map((part) => part[0])
                    .join("")}
                </span>
                <h3 class="mt-4 text-lg font-extrabold">{coach.name}</h3>
                <p class="text-gym-accent text-sm font-bold">{coach.role}</p>
                <p class="text-gym-muted mt-3 text-[0.9375rem]">{coach.bio}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Membership -->
    <section
      id="membership"
      class="border-gym-line bg-gym-surface scroll-mt-32 border-y py-20"
    >
      <div class="mx-auto max-w-5xl px-5">
        <h2 class="text-3xl font-extrabold sm:text-4xl">Membership</h2>
        <p class="text-gym-muted mt-3 text-lg">
          Whatever you pick, you can stop whenever you like.
        </p>

        <ul class="mt-10 grid items-start gap-6 md:grid-cols-3">
          {
            memberships.map((plan) => (
              <li
                class:list={[
                  "bg-gym-paper relative rounded-2xl p-6",
                  plan.featured
                    ? "border-gym-accent border-2"
                    : "border-gym-line border",
                ]}
              >
                {plan.featured && (
                  <span class="bg-gym-accent absolute -top-3 left-6 rounded-full px-3 py-1 text-[0.65rem] font-bold tracking-wide text-white uppercase">
                    Most popular
                  </span>
                )}
                <h3 class="text-gym-muted text-sm font-bold tracking-wide uppercase">
                  {plan.name}
                </h3>
                <p class="mt-3 text-3xl font-extrabold">
                  {plan.price}
                  <span class="text-gym-muted text-base font-semibold">
                    {" "}
                    / {plan.per}
                  </span>
                </p>
                <p class="text-gym-muted mt-3 text-[0.9375rem]">{plan.note}</p>
              </li>
            ))
          }
        </ul>

        <p class="text-gym-muted mt-8 text-sm">
          First class is free, whichever you're thinking of. No card details to
          try one.
        </p>
      </div>
    </section>

    <!-- Free trial booking -->
    <section id="trial" class="scroll-mt-32 py-20">
      <div class="mx-auto max-w-2xl px-5">
        <header class="text-center">
          <h2 class="text-3xl font-extrabold sm:text-4xl">Book a free trial</h2>
          <p class="text-gym-muted mt-3">
            Pick a class off the timetable. We'll text you back to confirm
            there's a spot.
          </p>
        </header>

        <form
          id="trial-form"
          class="border-gym-line bg-gym-surface mt-10 rounded-2xl border p-7"
          novalidate
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="tr-name" class="block text-sm font-bold"
                >Your name</label
              >
              <input
                id="tr-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                class="border-gym-line bg-gym-paper mt-1.5 w-full rounded-lg border px-3.5 py-2.5"
              />
            </div>

            <div>
              <label for="tr-phone" class="block text-sm font-bold">Phone</label
              >
              <input
                id="tr-phone"
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                required
                class="border-gym-line bg-gym-paper mt-1.5 w-full rounded-lg border px-3.5 py-2.5"
              />
            </div>

            <div>
              <label for="tr-day" class="block text-sm font-bold"
                >Which day?</label
              >
              <select
                id="tr-day"
                name="day"
                class="border-gym-line bg-gym-paper mt-1.5 w-full rounded-lg border px-3.5 py-2.5"
              >
                {
                  days.map((day) => (
                    <option value={day.index}>{day.name}</option>
                  ))
                }
              </select>
            </div>

            <div class="sm:col-span-2">
              <label for="tr-class" class="block text-sm font-bold">
                Which class?
              </label>
              <select
                id="tr-class"
                name="session"
                class="border-gym-line bg-gym-paper mt-1.5 w-full rounded-lg border px-3.5 py-2.5"
              >
              </select>
              <p class="text-gym-muted mt-1.5 text-xs">
                The list changes with the day you pick.
              </p>
            </div>

            <div class="sm:col-span-2">
              <label for="tr-new" class="block text-sm font-bold">
                Trained before? <span class="text-gym-muted">(optional)</span>
              </label>
              <textarea
                id="tr-new"
                name="experience"
                rows="2"
                placeholder="Total beginner / used to lift years ago / dodgy knee"
                class="border-gym-line bg-gym-paper mt-1.5 w-full resize-y rounded-lg border px-3.5 py-2.5"
              ></textarea>
            </div>
          </div>

          <p
            id="tr-error"
            role="alert"
            hidden
            class="bg-gym-accent/10 text-gym-accent mt-5 rounded-lg px-4 py-3 text-sm font-bold"
          >
          </p>

          <button
            type="submit"
            class="bg-gym-ink mt-6 min-h-11 w-full rounded-lg px-6 py-3.5 font-bold text-white hover:opacity-90"
          >
            Request my free class
          </button>

          <p class="text-gym-muted mt-4 text-center text-xs">
            On a real site this would land in the studio's inbox and text you
            back. Here it just shows what happens next.
          </p>
        </form>

        <div
          id="tr-success"
          role="status"
          hidden
          class="border-gym-line bg-gym-surface mt-10 rounded-2xl border p-8 text-center"
        >
          <span
            aria-hidden="true"
            class="bg-gym-lime text-gym-ink mx-auto grid h-14 w-14 place-items-center rounded-full text-2xl font-bold"
            >✓</span
          >
          <h3 class="mt-5 text-2xl font-extrabold">You're on the list</h3>
          <p id="tr-summary" class="text-gym-muted mt-3"></p>
          <p class="text-gym-muted mt-4 text-sm">
            We'll text to confirm. Wear whatever you'd walk in; we've got the
            rest.
          </p>
          <button
            type="button"
            id="tr-again"
            class="text-gym-accent mt-6 text-sm font-bold underline underline-offset-4"
          >
            Book another
          </button>
        </div>
      </div>
    </section>
  </main>

  <footer
    class="border-gym-line text-gym-muted border-t py-10 text-center text-sm"
  >
    <p class="text-gym-ink font-extrabold">{studio.name}</p>
    <p class="mt-2">
      {studio.address} ·{" "}
      <a
        href={`tel:${tel}`}
        class="hover:text-gym-ink underline underline-offset-4"
      >
        {studio.phone}
      </a>
    </p>
    <p class="mt-4">
      <a href="/#work" class="font-bold underline underline-offset-4">
        This is a demo — back to the portfolio
      </a>
    </p>
  </footer>
</Base>

<script>
  import {
    days,
    sessionsFor,
    readableTime,
    type Session,
  } from "~/data/demo-gym";

  /* ── Pick out today ───────────────────────────────────────────────────── */

  const today = new Date().getDay();

  const column = document.querySelector(`section[data-day="${today}"]`);
  column?.classList.add("ring-gym-ink", "ring-2");
  column
    ?.querySelector<HTMLElement>("[data-today-flag]")
    ?.removeAttribute("hidden");

  /* Tell someone landing at 6am whether there's still a class today. */
  const line = document.getElementById("today-line");
  if (line) {
    const now = new Date();
    const minutesNow = now.getHours() * 60 + now.getMinutes();
    const remaining = sessionsFor(today).filter((session: Session) => {
      const [h, m] = session.start.split(":").map(Number);
      return h * 60 + m > minutesNow;
    });

    const next = remaining[0];
    line.textContent = next
      ? `Next class today: ${next.name} at ${readableTime(next.start)} · ${line.textContent?.trim()}`
      : `Nothing else on today — back at it tomorrow · ${line.textContent?.trim()}`;
  }

  /* ── Trial form ───────────────────────────────────────────────────────── */

  const form = document.getElementById("trial-form") as HTMLFormElement | null;
  const daySelect = document.getElementById(
    "tr-day",
  ) as HTMLSelectElement | null;
  const classSelect = document.getElementById(
    "tr-class",
  ) as HTMLSelectElement | null;
  const error = document.getElementById("tr-error");
  const success = document.getElementById("tr-success");
  const summary = document.getElementById("tr-summary");

  /* The class list is only useful if it matches the day above it. */
  const fillClasses = () => {
    if (!daySelect || !classSelect) return;
    const sessions = sessionsFor(Number(daySelect.value));

    classSelect.innerHTML = sessions.length
      ? sessions
          .map(
            (session: Session) =>
              `<option value="${session.name} at ${readableTime(session.start)}">${readableTime(session.start)} — ${session.name} (${session.coach})</option>`,
          )
          .join("")
      : `<option value="">No classes that day — pick another</option>`;
  };

  if (daySelect) {
    daySelect.value = String(today);
    daySelect.addEventListener("change", fillClasses);
    fillClasses();
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!error || !success || !summary) return;
    error.hidden = true;

    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const phone = String(data.get("phone") || "").trim();
    const session = String(data.get("session") || "");
    const dayName =
      days.find((day) => day.index === Number(data.get("day")))?.name ?? "";

    if (!name || phone.replace(/\D/g, "").length < 7) {
      error.textContent = name
        ? "That doesn't look like a number we can text."
        : "Please tell us your name.";
      error.hidden = false;
      form
        .querySelector<HTMLInputElement>(name ? "#tr-phone" : "#tr-name")
        ?.focus();
      return;
    }

    if (!session) {
      error.textContent = "Pick a day that has a class on it.";
      error.hidden = false;
      daySelect?.focus();
      return;
    }

    summary.textContent = `${name} — ${session}, ${dayName}. We'll text ${phone}.`;
    form.hidden = true;
    success.hidden = false;
    success.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  document.getElementById("tr-again")?.addEventListener("click", () => {
    if (!form || !success) return;
    form.reset();
    if (daySelect) daySelect.value = String(today);
    fillClasses();
    success.hidden = true;
    form.hidden = false;
    form.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>
