---
import "@fontsource-variable/plus-jakarta-sans";
import Base from "~/layouts/Base.astro";
import DemoBanner from "~/components/DemoBanner.astro";

/* ── Demo content ─────────────────────────────────────────────────────────
 * A made-up plumbing firm. The whole point of a page like this is that a
 * stranger can see the price and the coverage area before they ring, so the
 * phone only rings for jobs worth taking.
 * ─────────────────────────────────────────────────────────────────────── */

const business = {
  name: "Northgate Plumbing",
  strapline: "Gas Safe registered · Local since 2011",
  phone: "0800 123 4567",
  emergencyLine: "Burst pipe or no heating? We answer the phone 24 hours.",
  headline: "A plumber who turns up when he says he will.",
  blurb:
    "Boilers, leaks, bathrooms and blocked drains across Northgate and the surrounding villages. Fixed call-out fee, price agreed before we start, and we clear up after ourselves.",
};

const trustPoints = [
  "Gas Safe registered (No. 512994)",
  "Fixed £65 call-out, no hidden extras",
  "12-month guarantee on all work",
];

const services = [
  {
    title: "Boiler repair & servicing",
    body: "Annual services, breakdowns and landlord safety certificates. Most makes fixed same day.",
    icon: "flame",
  },
  {
    title: "Leaks & burst pipes",
    body: "Traced, isolated and repaired. We carry the common parts on the van.",
    icon: "drop",
  },
  {
    title: "Blocked drains & toilets",
    body: "High-pressure jetting and camera survey if the blockage keeps coming back.",
    icon: "wave",
  },
  {
    title: "Bathroom installation",
    body: "Full fit-out including tiling and waste. Typically four to six days.",
    icon: "bath",
  },
  {
    title: "Radiators & heating",
    body: "Power flushing, new radiators, thermostatic valves, cold-spot fixes.",
    icon: "radiator",
  },
  {
    title: "Taps, showers & cylinders",
    body: "The small jobs everyone else is too busy for. Usually under an hour.",
    icon: "shower",
  },
];

const prices = [
  {
    job: "Call-out (first hour included)",
    price: "£65",
    note: "Weekdays 8am–6pm",
  },
  {
    job: "Each additional hour",
    price: "£45",
    note: "Charged in 30-min blocks",
  },
  {
    job: "Emergency call-out",
    price: "£110",
    note: "Evenings, weekends, bank holidays",
  },
  { job: "Boiler service", price: "£85", note: "Fixed price, any make" },
  {
    job: "Landlord gas safety certificate",
    price: "£95",
    note: "Up to 3 appliances",
  },
  {
    job: "Blocked drain clearance",
    price: "from £120",
    note: "Quoted before we start",
  },
];

const areas = [
  "Northgate",
  "Riverside",
  "Ashcombe",
  "Little Denton",
  "Whitmoor",
  "Kingsbury",
  "Elmfield",
  "Barrow Hill",
];

const reviews = [
  {
    quote:
      "Came out on a Sunday for a burst pipe under the sink. Fixed in forty minutes and charged exactly what he quoted on the phone.",
    name: "Helen R.",
    place: "Ashcombe",
  },
  {
    quote:
      "Fitted our whole bathroom. Turned up at eight every morning, cleaned up every night, finished a day early.",
    name: "Dan & Priya M.",
    place: "Northgate",
  },
  {
    quote:
      "Two other firms said we needed a new boiler. Northgate found a stuck valve and charged us for one hour.",
    name: "Terry W.",
    place: "Whitmoor",
  },
];

/** Small inline icon set — no icon library for six shapes. */
const icons: Record<string, string> = {
  flame:
    "M12 2c.6 3.6-1.4 5-2.9 6.4C7.3 10 6 11.5 6 14a6 6 0 0 0 12 0c0-2.2-1-3.7-2.2-5.2-.6 1-1.4 1.6-2.3 1.9.7-2.3.4-5.6-1.5-8.7Z",
  drop: "M12 2.7c3.4 4 6 7.3 6 10.5a6 6 0 0 1-12 0c0-3.2 2.6-6.5 6-10.5Z",
  wave: "M2 8.5c2.2-2 4.3-2 6.5 0s4.3 2 6.5 0 4.3-2 6.5 0v2.6c-2.2-2-4.3-2-6.5 0s-4.3 2-6.5 0-4.3-2-6.5 0V8.5Zm0 6c2.2-2 4.3-2 6.5 0s4.3 2 6.5 0 4.3-2 6.5 0v2.6c-2.2-2-4.3-2-6.5 0s-4.3 2-6.5 0-4.3-2-6.5 0v-2.6Z",
  bath: "M4 4a2 2 0 0 1 4 0v1H4V4Zm-2 7h20v2a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5v-2Zm2-8v6H2V3a1 1 0 0 1 2 0Zm2 16 -1 2h2l1-2H6Zm12 0 1 2h-2l-1-2h2Z",
  radiator: "M4 3h2v18H4V3Zm4.7 0h2v18h-2V3Zm4.6 0h2v18h-2V3ZM18 3h2v18h-2V3Z",
  shower:
    "M12 2a5 5 0 0 0-5 5v2H5v2h14V9h-2V7a5 5 0 0 0-5-5Zm-4 12a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm4 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm4 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2ZM8 18a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm4 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm4 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z",
};

const tel = business.phone.replace(/\s/g, "");
const nav = [
  { href: "#services", label: "Services" },
  { href: "#prices", label: "Prices" },
  { href: "#areas", label: "Areas" },
  { href: "#reviews", label: "Reviews" },
];
---

<Base
  title={`${business.name} — emergency plumber, Northgate (demo site)`}
  description="Demo service-business landing page: services, transparent prices, coverage area and a callback form."
  noindex
  forceLight
  alternates={false}
  bodyClass="bg-trade-paper text-trade-ink font-trade"
>
  <a href="#main" class="skip-link">Skip to content</a>

  <div class="sticky top-0 z-50">
    <DemoBanner business={business.name} />

    <!-- Emergency line. On a real trade site this is the highest-value pixel
         on the page, so it goes above the logo and stays put. -->
    <div class="bg-trade-urgent text-white">
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-3 gap-y-1 px-5 py-2 text-center text-sm sm:justify-between sm:text-left"
      >
        <p>{business.emergencyLine}</p>
        <a href={`tel:${tel}`} class="font-bold underline underline-offset-4">
          {business.phone}
        </a>
      </div>
    </div>

    <header
      class="border-trade-line bg-trade-surface/95 border-b backdrop-blur-md"
    >
      <div
        class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5"
      >
        <a href="#top" class="flex items-center gap-2.5">
          <span
            aria-hidden="true"
            class="bg-trade-accent grid h-9 w-9 place-items-center rounded-lg text-sm font-extrabold text-white"
            >NP</span
          >
          <span class="leading-tight">
            <span class="block font-extrabold tracking-tight"
              >{business.name}</span
            >
            <span class="text-trade-muted hidden text-xs sm:block">
              {business.strapline}
            </span>
          </span>
        </a>

        <nav aria-label="Main" class="flex items-center gap-1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="text-trade-muted hover:text-trade-ink hidden rounded px-3 py-2 text-sm font-semibold lg:inline-block"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={`tel:${tel}`}
            class="bg-trade-accent ml-1 inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-bold text-white hover:opacity-90"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-4 w-4"
            >
              <path
                d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z"
              ></path>
            </svg>
            Call now
          </a>
        </nav>
      </div>
    </header>
  </div>

  <main id="main">
    <!-- Hero + callback form -->
    <section id="top" class="border-trade-line bg-trade-surface border-b">
      <div
        class="mx-auto grid max-w-6xl items-start gap-12 px-5 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:py-20"
      >
        <div>
          <h1 class="text-4xl leading-[1.1] font-extrabold sm:text-5xl">
            {business.headline}
          </h1>
          <p class="text-trade-muted mt-5 max-w-xl text-lg">{business.blurb}</p>

          <ul class="mt-8 space-y-3">
            {
              trustPoints.map((point) => (
                <li class="flex items-start gap-3 font-semibold">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="text-trade-accent mt-0.5 h-5 w-5 shrink-0"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.53a.75.75 0 0 0-1.22-.87l-3.24 4.53-1.62-1.62a.75.75 0 0 0-1.06 1.06l2.24 2.24a.75.75 0 0 0 1.14-.094l3.76-5.25Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  {point}
                </li>
              ))
            }
          </ul>

          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href={`tel:${tel}`}
              class="bg-trade-accent rounded-lg px-6 py-3.5 font-bold text-white hover:opacity-90"
            >
              Call {business.phone}
            </a>
            <a
              href="#callback"
              class="border-trade-line hover:border-trade-accent rounded-lg border-2 px-6 py-3.5 font-bold"
            >
              Ask for a callback
            </a>
          </div>
        </div>

        <!-- Callback form: the whole reason this page exists. -->
        <div
          id="callback"
          class="border-trade-line bg-trade-paper scroll-mt-44 rounded-2xl border p-7 shadow-sm"
        >
          <h2 class="text-xl font-extrabold">Get a callback</h2>
          <p class="text-trade-muted mt-2 text-sm">
            Leave your number and we'll ring you back — usually within the hour,
            during working hours.
          </p>

          <form id="callback-form" class="mt-6 space-y-4" novalidate>
            <div>
              <label for="cb-name" class="block text-sm font-bold"
                >Your name</label
              >
              <input
                id="cb-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                class="border-trade-line bg-trade-surface mt-1.5 w-full rounded-lg border px-3.5 py-2.5"
              />
            </div>

            <div>
              <label for="cb-phone" class="block text-sm font-bold">
                Phone number
              </label>
              <input
                id="cb-phone"
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                required
                class="border-trade-line bg-trade-surface mt-1.5 w-full rounded-lg border px-3.5 py-2.5"
              />
            </div>

            <div>
              <label for="cb-job" class="block text-sm font-bold">
                What needs doing?
              </label>
              <select
                id="cb-job"
                name="job"
                class="border-trade-line bg-trade-surface mt-1.5 w-full rounded-lg border px-3.5 py-2.5"
              >
                {
                  [
                    "Boiler repair or service",
                    "Leak or burst pipe",
                    "Blocked drain or toilet",
                    "Bathroom installation",
                    "Radiators or heating",
                    "Something else",
                  ].map((option) => <option>{option}</option>)
                }
              </select>
            </div>

            <fieldset>
              <legend class="text-sm font-bold">How urgent?</legend>
              <div class="mt-2 space-y-2">
                {
                  [
                    { value: "emergency", label: "It's an emergency — today" },
                    { value: "week", label: "This week" },
                    { value: "quote", label: "Just after a quote" },
                  ].map((option) => (
                    <label class="flex items-center gap-2.5 text-[0.9375rem]">
                      <input
                        type="radio"
                        name="when"
                        value={option.value}
                        checked={option.value === "week"}
                        class="h-4 w-4 accent-[var(--color-trade-accent)]"
                      />
                      {option.label}
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <p
              id="cb-error"
              role="alert"
              hidden
              class="bg-trade-urgent/10 text-trade-urgent rounded-lg px-4 py-3 text-sm font-bold"
            >
            </p>

            <button
              type="submit"
              class="bg-trade-accent w-full rounded-lg px-6 py-3.5 font-bold text-white hover:opacity-90"
            >
              Request a callback
            </button>

            <p class="text-trade-muted text-center text-xs">
              On a real site this would land in the plumber's inbox and phone.
            </p>
          </form>

          <div id="cb-success" role="status" hidden class="py-6 text-center">
            <span
              aria-hidden="true"
              class="bg-trade-accent mx-auto grid h-14 w-14 place-items-center rounded-full text-2xl text-white"
              >✓</span
            >
            <h3 class="mt-5 text-xl font-extrabold">We'll ring you back</h3>
            <p id="cb-summary" class="text-trade-muted mt-3"></p>
            <p class="text-trade-muted mt-4 text-sm">
              Can't wait? Ring
              <a
                href={`tel:${tel}`}
                class="text-trade-accent font-bold underline"
              >
                {business.phone}
              </a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="scroll-mt-44 py-20">
      <div class="mx-auto max-w-6xl px-5">
        <h2 class="text-3xl font-extrabold sm:text-4xl">What we do</h2>
        <p class="text-trade-muted mt-3 max-w-2xl text-lg">
          Domestic plumbing and heating. If it's on this list, we do it most
          days of the week.
        </p>

        <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((service) => (
              <li class="border-trade-line bg-trade-surface rounded-2xl border p-6">
                <span
                  aria-hidden="true"
                  class="bg-trade-accent/10 text-trade-accent grid h-11 w-11 place-items-center rounded-xl"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
                    <path d={icons[service.icon]} />
                  </svg>
                </span>
                <h3 class="mt-4 text-lg font-extrabold">{service.title}</h3>
                <p class="text-trade-muted mt-2 text-[0.9375rem]">
                  {service.body}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Prices -->
    <section
      id="prices"
      class="border-trade-line bg-trade-surface scroll-mt-44 border-y py-20"
    >
      <div class="mx-auto max-w-4xl px-5">
        <h2 class="text-3xl font-extrabold sm:text-4xl">What it costs</h2>
        <p class="text-trade-muted mt-3 text-lg">
          Published, so you don't have to ring up to find out. Anything bigger
          gets a written quote before a spanner comes out.
        </p>

        <table class="mt-10 w-full border-collapse text-left">
          <caption class="sr-only">Standard prices</caption>
          <thead>
            <tr class="border-trade-ink border-b-2">
              <th
                scope="col"
                class="py-3 text-sm font-extrabold tracking-wide uppercase"
              >
                Job
              </th>
              <th
                scope="col"
                class="py-3 text-right text-sm font-extrabold tracking-wide uppercase"
              >
                Price
              </th>
            </tr>
          </thead>
          <tbody>
            {
              prices.map((row) => (
                <tr class="border-trade-line border-b">
                  <td class="py-4 pr-4">
                    <span class="block font-bold">{row.job}</span>
                    <span class="text-trade-muted block text-sm">
                      {row.note}
                    </span>
                  </td>
                  <td class="py-4 text-right align-top text-lg font-extrabold whitespace-nowrap">
                    {row.price}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <p class="text-trade-muted mt-6 text-sm">
          Prices include VAT. Parts charged at cost — we'll show you the
          receipt.
        </p>
      </div>
    </section>

    <!-- Areas -->
    <section id="areas" class="scroll-mt-44 py-20">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 class="text-3xl font-extrabold sm:text-4xl">Where we work</h2>
          <p class="text-trade-muted mt-3 text-lg">
            Anywhere within about twenty minutes of the yard. If you're just
            outside, ring anyway — we're often nearby.
          </p>
          <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-2">
            {
              areas.map((area) => (
                <li class="bg-trade-surface flex items-center gap-2.5 rounded-lg px-4 py-3 font-bold">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="text-trade-accent h-4 w-4 shrink-0"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 2a6 6 0 0 0-6 6c0 4.2 5.2 9.5 5.4 9.7a.8.8 0 0 0 1.2 0C10.8 17.5 16 12.2 16 8a6 6 0 0 0-6-6Zm0 8.2A2.2 2.2 0 1 1 10 5.8a2.2 2.2 0 0 1 0 4.4Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  {area}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="border-trade-line bg-trade-surface rounded-2xl border p-7">
          <h3 class="text-xl font-extrabold">Our guarantee</h3>
          <ul class="mt-5 space-y-4">
            {
              [
                {
                  title: "Price agreed before we start",
                  body: "If it turns out bigger than expected, we stop and re-quote. We never just carry on and bill you.",
                },
                {
                  title: "12 months on our workmanship",
                  body: "If the same fault comes back within a year, we come back free.",
                },
                {
                  title: "Clean up after ourselves",
                  body: "Dust sheets down, tools out, floor swept. You shouldn't be able to tell we were there.",
                },
              ].map((item) => (
                <li>
                  <h4 class="font-extrabold">{item.title}</h4>
                  <p class="text-trade-muted mt-1 text-[0.9375rem]">
                    {item.body}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Reviews -->
    <section
      id="reviews"
      class="border-trade-line bg-trade-surface scroll-mt-44 border-y py-20"
    >
      <div class="mx-auto max-w-6xl px-5">
        <h2 class="text-3xl font-extrabold sm:text-4xl">What customers say</h2>
        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {
            reviews.map((review) => (
              <li class="border-trade-line bg-trade-paper rounded-2xl border p-6">
                <div
                  class="text-trade-urgent flex gap-0.5"
                  role="img"
                  aria-label="Rated 5 out of 5"
                >
                  {[0, 1, 2, 3, 4].map(() => (
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-4 w-4"
                    >
                      <path d="M10 1.5 12.6 7l6 .9-4.3 4.2 1 6-5.3-2.8L4.7 18l1-6L1.4 7.9 7.4 7 10 1.5Z" />
                    </svg>
                  ))}
                </div>
                <blockquote class="mt-4 text-[0.9375rem]">
                  <p>“{review.quote}”</p>
                </blockquote>
                <p class="mt-4 text-sm font-bold">
                  {review.name}
                  <span class="text-trade-muted font-normal">
                    {" "}
                    · {review.place}
                  </span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="bg-trade-ink py-16 text-white">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 text-center"
      >
        <h2 class="text-3xl font-extrabold">Need a plumber today?</h2>
        <p class="max-w-lg text-white/75">
          Ring us and you'll speak to the person who'll be doing the job — not a
          call centre.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href={`tel:${tel}`}
            class="text-trade-ink rounded-lg bg-white px-7 py-3.5 font-bold hover:bg-white/90"
          >
            Call {business.phone}
          </a>
          <a
            href="#callback"
            class="rounded-lg border-2 border-white/30 px-7 py-3.5 font-bold hover:bg-white/10"
          >
            Ask for a callback
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="text-trade-muted py-10 text-center text-sm">
    <p class="text-trade-ink font-extrabold">{business.name}</p>
    <p class="mt-2">{business.strapline} · {business.phone}</p>
    <p class="mt-4">
      <a href="/#work" class="font-bold underline underline-offset-4">
        This is a demo — back to the portfolio
      </a>
    </p>
  </footer>
</Base>

<script>
  const form = document.getElementById(
    "callback-form",
  ) as HTMLFormElement | null;
  const error = document.getElementById("cb-error");
  const success = document.getElementById("cb-success");
  const summary = document.getElementById("cb-summary");

  const urgencyText: Record<string, string> = {
    emergency: "We'll call you straight back.",
    week: "We'll call you back within the hour to book you in this week.",
    quote: "We'll call you back today with a price.",
  };

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!error || !success || !summary) return;

    error.hidden = true;

    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const phone = String(data.get("phone") || "").trim();
    const job = String(data.get("job") || "");
    const when = String(data.get("when") || "week");

    /* Loose on purpose — real people type numbers every which way. */
    const digits = phone.replace(/\D/g, "");

    if (!name || digits.length < 7) {
      error.textContent = name
        ? "That doesn't look like a phone number we can ring."
        : "Please tell us your name.";
      error.hidden = false;
      form
        .querySelector<HTMLInputElement>(name ? "#cb-phone" : "#cb-name")
        ?.focus();
      return;
    }

    summary.textContent = `Thanks ${name} — ${job.toLowerCase()}, on ${phone}. ${urgencyText[when] ?? ""}`;
    form.hidden = true;
    success.hidden = false;
  });
</script>
